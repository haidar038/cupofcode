---
export const prerender = true;
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE_TITLE } from "../../consts";
import { Copy } from "@lucide/astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import BackToTop from "../../components/ui/BackToTop.tsx";

export async function getStaticPaths() {
  const snippets = await getCollection("snippets");
  return snippets.map((snippet) => ({
    params: { slug: snippet.id },
    props: { snippet },
  }));
}

const { snippet } = Astro.props;
const { Content } = await render(snippet);

const langColors: Record<string, string> = {
  typescript: "border-blue-200 bg-blue-50 text-blue-700",
  javascript: "border-yellow-200 bg-yellow-50 text-yellow-700",
  css: "border-pink-200 bg-pink-50 text-pink-700",
  html: "border-orange-200 bg-orange-50 text-orange-700",
};
---

<BaseLayout
  title={`${snippet.data.title} | ${SITE_TITLE}`}
  description={snippet.data.description}
  type="article"
>
  <Breadcrumb
    items={[
      { label: "Snippets", href: "/snippets" },
      { label: snippet.data.title },
    ]}
  />

  <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
    <article class="lg:col-span-8">
      <div class="mb-5 flex items-start justify-between">
        <span
          class:list={[
            "flex items-center gap-1.5 rounded-lg border px-3 py-1 font-mono text-xs font-medium",
            langColors[snippet.data.language] || "border-gray-200 bg-gray-50 text-gray-700",
          ]}
        >
          {snippet.data.language}
        </span>
      </div>

      <h1 class="mb-4 font-coc-display text-3xl font-bold leading-tight text-coc-text md:text-4xl">
        {snippet.data.title}
      </h1>
      <p class="mb-8 text-lg leading-relaxed text-coc-muted">
        {snippet.data.description}
      </p>

      <div class="rounded-2xl border border-coc-line bg-coc-surface p-6 md:p-8">
        <div class="prose prose-gray max-w-none text-coc-muted">
          <Content />
        </div>
      </div>
    </article>

    <aside class="lg:col-span-4">
      <div class="sticky top-28 rounded-3xl border border-coc-line bg-coc-surface p-6">
        <h3 class="mb-4 text-sm font-bold uppercase tracking-wider text-coc-text">
          Info Snippet
        </h3>
        <div class="space-y-4 text-sm">
          <div class="flex items-center justify-between border-b border-coc-line py-2">
            <span class="text-coc-muted">Bahasa</span>
            <span class="font-semibold text-coc-text">{snippet.data.language}</span>
          </div>
        </div>

        <button
          class="mt-6 flex w-full items-center justify-center gap-2 rounded-xl bg-coc-dark px-6 py-3 font-bold text-white transition-all hover:bg-black"
          onclick="navigator.clipboard.writeText(document.querySelector('.prose code')?.textContent || '')"
        >
          <Copy width="18" height="18" />
          Salin Kode
        </button>
      </div>
    </aside>
  </div>
  <BackToTop client:idle />
</BaseLayout>
