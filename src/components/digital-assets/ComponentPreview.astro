---
import CodeBlock from "../ui/CodeBlock.astro";
import type { CodeSegment } from "../../lib/markdown";

interface Props {
  blocks: CodeSegment[];
  format?: string;
}

const { blocks, format } = Astro.props;
---

<div class="overflow-hidden rounded-3xl border border-coc-line bg-coc-surface">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-coc-line bg-gray-50 px-4 py-3">
    <span class="rounded-lg bg-white px-3 py-1.5 text-sm font-bold text-coc-text">Source Code</span>
    {format && (
      <span class="rounded-lg border border-blue-200 bg-blue-50 px-2 py-1 font-mono text-xs font-bold text-blue-700">
        {format}
      </span>
    )}
  </div>
  <div class="bg-coc-bg p-2 sm:p-4">
    {
      blocks.length > 0 ? (
        blocks.map((block) => (
          <CodeBlock
            code={block.code}
            language={block.lang}
            label={block.label}
          />
        ))
      ) : (
        <p class="px-4 py-8 text-center text-sm text-coc-muted-soft">
          Belum ada source code untuk komponen ini.
        </p>
      )
    }
  </div>
</div>
