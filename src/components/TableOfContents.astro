---
// Nested "Daftar Isi": h2 sections are the top-level items, their h3
// sub-sections render as expandable children. Documents that only use h2 stay
// a flat list, so the snippets/assets pages render exactly as before.
import { buildHeadingTree, type Heading, type TocNode } from "../lib/markdown";
import TocItem from "./TocItem.astro";

interface Props {
    headings: Heading[];
    title?: string;
}

const { headings, title = "Daftar Isi" } = Astro.props;

const tree = buildHeadingTree(headings);
// Nested mode only when there is real hierarchy; otherwise plain flat list.
const nested = tree.some((node: TocNode) => node.children.length > 0);
---

{
    tree.length > 0 && (
        <div class="flex max-h-[calc(100dvh-3rem)] flex-col gap-4 rounded-3xl border border-coc-line bg-coc-surface p-6" data-toc>
            <h2 class="shrink-0 text-sm font-bold uppercase tracking-wider text-coc-text">{title}</h2>
            <nav aria-label="Daftar isi" data-toc-nav class="toc-scroll min-h-0 flex-1 overflow-y-auto overscroll-contain pr-1">
                <ul class="space-y-1">
                    {tree.map((node) => (
                        <TocItem node={node} nested={nested} />
                    ))}
                </ul>
            </nav>
        </div>
    )
}

<style is:global>
    .toc-link {
        position: relative;
    }
    .toc-link.is-active {
        color: var(--color-text);
        font-weight: 700;
    }
    .toc-link.is-active .toc-dot {
        background: var(--color-accent);
        border-color: transparent;
    }
    /* Collapsible children: animated with the 0fr -> 1fr grid trick so no JS
       measurement is needed. */
    .toc-children {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 200ms ease;
    }
    .toc-children > div {
        overflow: hidden;
    }
    .toc-children.is-open {
        grid-template-rows: 1fr;
    }
    .toc-toggle {
        transition: transform 200ms ease;
    }
    .toc-toggle[aria-expanded="true"] {
        transform: rotate(90deg);
    }
    /* Thin scrollbars for the scrollable ToC card. */
    .toc-scroll {
        scrollbar-width: thin;
        scrollbar-color: var(--color-line) transparent;
    }
    .toc-scroll::-webkit-scrollbar {
        width: 6px;
    }
    .toc-scroll::-webkit-scrollbar-track {
        background: transparent;
    }
    .toc-scroll::-webkit-scrollbar-thumb {
        background: var(--color-line);
        border-radius: 9999px;
    }
</style>

<script>
    const nav = document.querySelector<HTMLElement>("[data-toc-nav]");

    if (nav) {
        const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>(".toc-link"));

        const expandGroup = (toggle: HTMLButtonElement, open: boolean) => {
            toggle.setAttribute("aria-expanded", String(open));
            const panelId = toggle.getAttribute("aria-controls");
            if (!panelId) return;
            document.getElementById(panelId)?.classList.toggle("is-open", open);
        };

        // Chevron buttons: manual expand/collapse.
        for (const toggle of nav.querySelectorAll<HTMLButtonElement>(".toc-toggle")) {
            toggle.addEventListener("click", () => {
                const isOpen = toggle.getAttribute("aria-expanded") === "true";
                expandGroup(toggle, !isOpen);
            });
        }

        // Clicking a parent link scrolls and opens its own group.
        for (const link of links) {
            const toggleBtn = link.closest(".toc-item")?.querySelector<HTMLButtonElement>(".toc-toggle");
            if (toggleBtn) {
                link.addEventListener("click", () => expandGroup(toggleBtn, true));
            }
        }

        const targets = links
            .map((link) => {
                const id = link.getAttribute("href")?.slice(1) ?? "";
                const heading = document.getElementById(id);
                return heading ? { id, link, heading } : null;
            })
            .filter(
                (
                    t,
                ): t is {
                    id: string;
                    link: HTMLAnchorElement;
                    heading: HTMLElement;
                } => t !== null,
            );

        if (targets.length) {
            const setActive = (id: string) => {
                for (const { link, id: linkId } of targets) {
                    link.classList.toggle("is-active", linkId === id);
                }
            };

            // When the active heading changes, keep exactly its branch open:
            // the item's own children plus every ancestor panel. Other open
            // branches collapse so the sidebar stays compact on long posts.
            const syncPanels = (link: HTMLAnchorElement) => {
                const activeItem = link.closest(".toc-item");
                if (!activeItem) return;
                const chain = new Set<Element>();
                let el: Element | null = activeItem;
                while (el) {
                    chain.add(el);
                    const ownPanel = el.querySelector<HTMLElement>(":scope > .toc-children");
                    if (ownPanel) chain.add(ownPanel);
                    const parentPanel: HTMLElement | null = el.parentElement?.closest<HTMLElement>(".toc-children") ?? null;
                    if (!parentPanel) break;
                    chain.add(parentPanel);
                    el = parentPanel.closest<HTMLElement>(".toc-item");
                }
                for (const panel of nav.querySelectorAll<HTMLElement>(".toc-children")) {
                    const open = chain.has(panel);
                    panel.classList.toggle("is-open", open);
                    const toggleBtn = panel.closest(".toc-item")?.querySelector<HTMLButtonElement>(".toc-toggle");
                    if (toggleBtn) toggleBtn.setAttribute("aria-expanded", String(open));
                }
            };

            // Keep the active link inside the visible part of the scrollable
            // nav without moving the page: adjust only nav.scrollTop.
            const keepActiveVisible = (link: HTMLAnchorElement) => {
                const navRect = nav.getBoundingClientRect();
                const linkRect = link.getBoundingClientRect();
                if (linkRect.top < navRect.top) {
                    nav.scrollTop -= navRect.top - linkRect.top + 8;
                } else if (linkRect.bottom > navRect.bottom) {
                    nav.scrollTop += linkRect.bottom - navRect.bottom + 8;
                }
            };

            let raf = 0;
            let activeId = targets[0].id;
            let lastSyncedId = "";
            const update = () => {
                raf = 0;
                const doc = document.documentElement;
                const scrollY = window.scrollY;
                const viewportBottom = scrollY + window.innerHeight;
                const nearBottom = viewportBottom >= doc.scrollHeight - 8;
                const marker = scrollY + window.innerHeight * 0.35;

                // The active section is the last heading that has passed the
                // marker (35% down the viewport).
                let current = targets[0].id;
                for (const t of targets) {
                    if (t.heading.getBoundingClientRect().top + scrollY <= marker) current = t.id;
                }

                if (nearBottom) {
                    activeId = targets[targets.length - 1].id;
                } else {
                    activeId = current;
                }

                // Re-sync expand/collapse only when the section changes, so a
                // manually collapsed panel is not re-opened on every frame.
                if (activeId !== lastSyncedId) {
                    lastSyncedId = activeId;
                    setActive(activeId);
                    const activeLink = targets.find((t) => t.id === activeId)?.link;
                    if (activeLink) {
                        syncPanels(activeLink);
                        keepActiveVisible(activeLink);
                    }
                }
            };

            const onScroll = () => {
                if (raf === 0) raf = window.requestAnimationFrame(update);
            };

            update();
            window.addEventListener("scroll", onScroll, { passive: true });
            window.addEventListener("resize", onScroll, { passive: true });
        }
    }
</script>
