---
export const prerender = true;
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getPublishedPosts } from "../../../lib/content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { ImageIcon } from "@lucide/astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import Pagination from "../../../components/Pagination.astro";
import CategoryFilter from "../../../components/CategoryFilter.astro";
import SearchBar from "../../../components/ui/SearchBar.tsx";
import BackToTop from "../../../components/ui/BackToTop.tsx";
import ScrollAnimations from "../../../components/ScrollAnimations.astro";
import { SITE_TITLE, SITE_URL } from "../../../consts";

// Prerendered path-based pagination (/posts/{kategori}, /posts/{kategori}/2).
// Halaman kategori sebelumnya SSR sehingga tidak pernah masuk sitemap
// (integrasi @astrojs/sitemap hanya mencakup route prerendered); dengan
// pagination berbasis path tiap halaman juga punya canonical sendiri.
// Kategori `aset-digital` sengaja tidak digenerate: itu content type dengan
// hub sendiri di /assets. Kategori tak dikenal kini 404 (sebelumnya redirect).
// Catatan: konstanta didefinisikan di dalam getStaticPaths — deklarasi
// top-level frontmatter tidak ikut ter-bundle ke chunk prerender Astro.
export async function getStaticPaths({ paginate }) {
    const POSTS_PER_PAGE = 6;

    const [posts, categories] = await Promise.all([getPublishedPosts(), getCollection("categories")]);
    const articleCategories = categories.filter((c) => c.id !== "aset-digital");

    return articleCategories.flatMap((category) =>
        paginate(
            posts.filter((p) => p.data.category === category.id),
            { params: { category: category.id }, pageSize: POSTS_PER_PAGE, props: { category } },
        ),
    );
}

const { category, page } = Astro.props;

const allPosts = await getPublishedPosts();
const categoryPosts = allPosts.filter((p) => p.data.category === category.id);
const categories = await getCollection("categories");
const filterCategories = categories.filter((c) => c.id !== "aset-digital");
const categoryLabel = new Map(categories.map((c) => [c.id, c.data.label] as const));
const searchItems = allPosts.map((p) => ({
    title: p.data.title,
    description: p.data.description ?? "",
    url: `/posts/${p.id}`,
    category: categoryLabel.get(p.data.category) ?? "",
}));

const categoryUrl = new URL(`/posts/${category.id}`, SITE_URL).href;
const pageUrl = page.currentPage > 1 ? `${categoryUrl}/${page.currentPage}` : categoryUrl;
const pageTitle = page.currentPage > 1 ? `${category.data.label} — Halaman ${page.currentPage} | ${SITE_TITLE}` : `${category.data.label} | ${SITE_TITLE}`;
const breadcrumbItems = [
    { name: "Beranda", url: new URL("/", SITE_URL).href },
    { name: "Artikel", url: new URL("/posts", SITE_URL).href },
    { name: category.data.label, url: categoryUrl },
];
const collectionLd = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${pageUrl}#collection`,
    url: pageUrl,
    name: pageTitle,
    description: category.data.description,
    isPartOf: { "@id": `${SITE_URL}/#website` },
    breadcrumb: { "@id": `${pageUrl}#breadcrumb` },
    mainEntity: {
        "@type": "ItemList",
        itemListElement: categoryPosts.map((post, index) => ({
            "@type": "ListItem",
            position: index + 1,
            url: new URL(`/posts/${post.id}`, SITE_URL).href,
            name: post.data.title,
        })),
    },
};
const breadcrumbLd = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${pageUrl}#breadcrumb`,
    itemListElement: breadcrumbItems.map((item, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: item.name,
        item: item.url,
    })),
};
const dateFormatter = new Intl.DateTimeFormat("id-ID", {
    day: "numeric",
    month: "long",
    year: "numeric",
});
---

<BaseLayout title={pageTitle} description={category.data.description}>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

    <Breadcrumb items={[{ label: "Artikel", href: "/posts" }, { label: category.data.label }]} />

    <header class="mx-auto mb-8 flex max-w-3xl flex-col items-center text-center">
        <p class="mb-6 inline-block rounded-full bg-coc-tag-yellow px-3 py-1 text-xs font-semibold text-[#212121]">Kategori</p>
        <h1 class="mb-3 font-coc-display text-4xl leading-tight tracking-tight text-coc-text md:text-5xl">
            {category.data.label}
        </h1>
        <p class="mx-auto max-w-2xl text-base leading-relaxed text-coc-muted md:text-lg">{category.data.description}</p>
    </header>

    <div class="mx-auto mb-10 max-w-md">
        <SearchBar items={searchItems} placeholder="Cari artikel..." client:idle />
    </div>

    <CategoryFilter categories={filterCategories} active={category.id} basePath="/posts" linkFor={(id) => `/posts/${id}`} />

    {
        categoryPosts.length > 0 ? (
            <section class="mx-auto max-w-7xl pb-18" aria-labelledby="category-articles">
                <h2 id="category-articles" class="sr-only">
                    Artikel dalam kategori {category.data.label}
                </h2>
                <div class="grid grid-cols-1 gap-y-14 gap-x-8 md:grid-cols-2 lg:grid-cols-3">
                    {page.data.map((post, i) => (
                        <a data-animate href={`/posts/${post.id}`} class="group block overflow-hidden transition-all duration-300" style={`--d:${(i % 6) * 60}ms`}>
                            <div class="relative mb-6 aspect-391/249 w-full overflow-hidden rounded-xl bg-[#d9d9d9]">
                                {post.data.featured_image ? (
                                    <Image
                                        src={post.data.featured_image}
                                        alt={post.data.title}
                                        width={800}
                                        height={512}
                                        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                                        densities={[1, 2]}
                                        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                                        loading="lazy"
                                    />
                                ) : (
                                    <div class="flex h-full w-full items-center justify-center text-[#aaa]">
                                        <ImageIcon width="64" height="64" stroke-width="1.8" />
                                    </div>
                                )}
                            </div>
                            <div>
                                <h3 class="mb-2 text-xl font-bold leading-snug text-coc-text transition-colors group-hover:text-coc-accent">{post.data.title}</h3>
                                {post.data.description && <p class="mb-6 line-clamp-2 text-sm text-coc-muted">{post.data.description}</p>}
                                <div class="flex items-center gap-2">
                                    <span class="text-xs text-coc-muted-soft">{post.data.publishDate ? dateFormatter.format(post.data.publishDate) : ""}</span>
                                </div>
                            </div>
                        </a>
                    ))}
                </div>

                <Pagination
                    page={page.currentPage}
                    totalPages={page.lastPage}
                    basePath={`/posts/${category.id}`}
                    hrefFor={(p: number) => (p === 1 ? `/posts/${category.id}` : `/posts/${category.id}/${p}`)}
                />
            </section>
        ) : (
            <div class="flex flex-col items-center justify-center py-20 text-center">
                <p class="text-lg text-coc-muted">Belum ada artikel untuk kategori ini.</p>
                <a href="/posts" class="mt-4 inline-flex items-center rounded-full bg-coc-dark px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-black">
                    Lihat Semua Artikel
                </a>
            </div>
        )
    }
    <BackToTop client:idle />
    <ScrollAnimations />
</BaseLayout>
