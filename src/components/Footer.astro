---
import { SITE_TITLE } from "../consts";
import NewsletterForm from "./ui/NewsletterForm.tsx";

const today = new Date();
---

<footer class="border-t border-[#ffbb001a] bg-coc-dark text-coc-muted-soft" id="kontak">
    <div class="mx-auto w-full max-w-360 px-6 pb-8 pt-18 lg:px-12">
        <div class="mb-10 grid grid-cols-1 items-start gap-6 md:grid-cols-2 md:gap-8 lg:grid-cols-[minmax(260px,394px)_1fr_1fr_minmax(220px,280px)] lg:gap-12">
            <section class="flex flex-col items-start gap-6" aria-label="Tentang Cup of Code">
                <a class="whitespace-nowrap font-coc-display text-5 font-medium leading-1.2 tracking-[-0.02em] text-white sm:text-[1.375rem]" href="/">{SITE_TITLE}</a>
                <p class="text-base leading-1.6 text-coc-muted-soft">
                    Temukan tutorial mendalam, tips & trik esensial, serta aset digital siap pakai untuk kebutuhan kamu sehari-hari buat ngembangin website dan aplikasi.
                </p>
                <div class="flex items-center gap-4 text-coc-muted-soft">
                    <a href="https://github.com/cupofcode" target="_blank" rel="noopener" class="transition-colors hover:text-coc-accent" aria-label="Cup of Code di GitHub">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                    </a>
                    <a href="https://twitter.com/cupofcode" target="_blank" rel="noopener" class="transition-colors hover:text-coc-accent" aria-label="Cup of Code di X (Twitter)">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
                    </a>
                </div>
            </section>
            <nav class="flex flex-col items-start gap-3" aria-label="Halaman">
                <h2 class="mb-3 font-coc-display text-base font-medium leading-1.4 tracking-[0.02em] text-coc-accent">HALAMAN</h2>
                <a class="text-base leading-1.6 text-coc-muted-soft transition-colors hover:text-coc-accent" href="/">Beranda</a>
                <a class="text-base leading-1.6 text-coc-muted-soft transition-colors hover:text-coc-accent" href="/posts">Artikel</a>
                <a class="text-base leading-1.6 text-coc-muted-soft transition-colors hover:text-coc-accent" href="/assets">Aset Digital</a>
                <a class="text-base leading-1.6 text-coc-muted-soft transition-colors hover:text-coc-accent" href="/snippets">Snippets</a>
                <a class="text-base leading-1.6 text-coc-muted-soft transition-colors hover:text-coc-accent" href="/about">Tentang</a>
                <a class="text-base leading-1.6 text-coc-muted-soft transition-colors hover:text-coc-accent" href="/editorial-policy">Kebijakan Editorial</a>
                <a class="text-base leading-1.6 text-coc-muted-soft transition-colors hover:text-coc-accent" href="/contact">Kontak</a>
            </nav>
            <nav class="flex flex-col items-start gap-3" aria-label="Kategori">
                <h2 class="mb-3 font-coc-display text-base font-medium leading-1.4 tracking-[0.02em] text-coc-accent">KATEGORI</h2>
                <a class="text-base leading-1.6 text-coc-muted-soft transition-colors hover:text-coc-accent" href="/posts/tips-trik">Tips & Trik</a>
                <a class="text-base leading-1.6 text-coc-muted-soft transition-colors hover:text-coc-accent" href="/posts/tutorial">Tutorial</a>
                <a class="text-base leading-1.6 text-coc-muted-soft transition-colors hover:text-coc-accent" href="/assets">Aset Digital</a>
                <a class="text-base leading-1.6 text-coc-muted-soft transition-colors hover:text-coc-accent" href="/privacy">Kebijakan Privasi</a>
                <a class="text-base leading-1.6 text-coc-muted-soft transition-colors hover:text-coc-accent" href="/terms">Syarat & Ketentuan</a>
            </nav>
            <section class="flex flex-col items-start gap-6" aria-label="Berlangganan">
                <h2 class="m-0 font-coc-display text-base font-medium leading-1.4 tracking-[0.02em] text-coc-accent">BERLANGGANAN</h2>
                <p class="text-base leading-1.6 text-coc-muted-soft">Dapatkan update artikel terbaru dan insight coding mingguan langsung ke inbox kamu.</p>
                <NewsletterForm client:idle />
            </section>
        </div>
        <div class="flex flex-col gap-4 border-t border-white/10 pt-8 text-sm leading-1.5 text-coc-muted-soft md:flex-row md:justify-between md:gap-6">
            <p class="text-base text-coc-muted-soft">
                &copy; {today.getFullYear()} Cup of Code. All rights reserved.
            </p>
            <div class="flex flex-col gap-4 md:flex-row md:gap-8">
                <a href="/privacy" class="text-base text-coc-muted-soft transition-colors hover:text-coc-accent">Privacy Policy</a>
                <a href="/terms" class="text-base text-coc-muted-soft transition-colors hover:text-coc-accent">Terms of Service</a>
            </div>
        </div>
    </div>
    <div class="h-1.5 w-full bg-linear-to-r from-coc-accent to-coc-green" aria-hidden="true"></div>
</footer>
