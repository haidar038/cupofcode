# ============================================================
# Cup of Code — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Site ---
PUBLIC_SITE_URL=https://cupofcode.cc
PUBLIC_SITE_TITLE=cup of code

# --- Keystatic CMS (Production) ---
# Gunakan GitHub storage untuk production
KEYSTATIC_GITHUB_CLIENT_ID=your_github_oauth_client_id
KEYSTATIC_GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
KEYSTATIC_SECRET=your_keystatic_encryption_secret
KEYSTATIC_STORAGE_KIND=github # 'local' untuk development, 'github' untuk production

# --- Analytics (Pilih salah satu) ---
# Umami (self-hosted / cloud) — rekomendasi
PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
PUBLIC_UMAMI_WEBSITE_ID=your-umami-website-id

# Google Analytics (alternatif)
# PUBLIC_GA_ID=G-XXXXXXXXXX

# --- Error Monitoring ---
PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/your-project
SENTRY_AUTH_TOKEN=your_sentry_auth_token_for_sourcemap_upload

# --- Google Search Console ---
# Dapatkan dari https://search.google.com/search-console setelah add property
# Format: string panjang alphanumeric dari Google (e.g. "abc123def456...")
PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-site-verification-code

# --- Email Services (Resend) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxx
EMAIL_FROM=Cup of Code <newsletter@cupofcode.cc>
EMAIL_ADMIN=admin@cupofcode.cc
# Audience ID Resend (dashboard → Audiences) — agar newsletter menyimpan
# subscriber. Tanpa ini, welcome email tetap terkirim tapi tidak ada list.
RESEND_AUDIENCE_ID=your_resend_audience_id

# --- Rate Limiting (Upstash Redis) ---
# Wajib di production (Vercel serverless): rate limit shared antar instance.
# Tanpa env ini, fallback ke in-memory per instance (cukup untuk dev lokal).
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
# Format "N/minute" atau "N/hour" — opsional
NEWSLETTER_RATE_LIMIT=1/min
CONTACT_RATE_LIMIT=5/hour
