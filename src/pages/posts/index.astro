---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { ImageIcon } from "@lucide/astro";
import { SITE_TITLE } from "../../consts";
import SearchBar from "../../components/ui/SearchBar.tsx";
import BackToTop from "../../components/ui/BackToTop.tsx";
import ScrollAnimations from "../../components/ScrollAnimations.astro";
import Pagination from "../../components/Pagination.astro";
import CategoryFilter from "../../components/CategoryFilter.astro";

const POSTS_PER_PAGE = 6;

const posts = await getCollection("posts");
const categories = await getCollection("categories");
const cat = Astro.url.searchParams.get("cat");

// "Aset Digital" is a content-type, not a post category — route it to /assets.
if (cat === "aset-digital") {
    return Astro.redirect("/assets");
}

const selectedCategory = cat ? categories.find((c) => c.id === cat) : undefined;

const filteredPosts = cat ? posts.filter((p) => p.data.category === cat) : posts;
const sortedPosts = [...filteredPosts].sort((a, b) => {
    const da = a.data.publishDate?.getTime() ?? 0;
    const db = b.data.publishDate?.getTime() ?? 0;
    return db - da;
});

const totalPages = Math.max(1, Math.ceil(sortedPosts.length / POSTS_PER_PAGE));
const rawPage = Number.parseInt(Astro.url.searchParams.get("page") ?? "1", 10);
const page = Number.isNaN(rawPage) ? 1 : Math.min(Math.max(rawPage, 1), totalPages);
const pagePosts = sortedPosts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE);

const categoryLabel = new Map<string, string>();
for (const c of categories) {
    categoryLabel.set(c.id, c.data.label);
}

const searchItems = posts.map((p) => ({
    title: p.data.title,
    description: p.data.description ?? "",
    url: `/posts/${p.id}`,
    category: categoryLabel.get(p.data.category) ?? "",
}));

// Filter pills only cover article categories — "Aset Digital" is a content
// type with its own hub page, so it is excluded (same rule as [category].astro).
const filterCategories = categories.filter((c) => c.id !== "aset-digital");
---

<BaseLayout
    title={`${selectedCategory ? selectedCategory.data.label + " — " : "Semua Artikel"} | ${SITE_TITLE}`}
    description={selectedCategory?.data.description ?? "Daftar semua artikel Cup of Code tentang coding, web development, UI/UX, dan AI."}
    robots={cat || page > 1 ? "noindex,follow" : undefined}
>
    <header class="mx-auto mb-8 flex max-w-3xl flex-col items-center text-center">
        <p class="mb-6 inline-block rounded-full bg-coc-tag-yellow px-3 py-1 text-xs font-semibold text-[#212121]">
            {cat ? "Kategori" : "Jelajahi"}
        </p>
        <h1 class="mb-3 font-coc-display text-4xl leading-tight tracking-tight text-coc-text md:text-5xl">
            {selectedCategory ? selectedCategory.data.label : "Semua Artikel"}
        </h1>
        <p class="mx-auto max-w-2xl text-base leading-relaxed text-coc-muted md:text-lg">
            {selectedCategory?.data.description ?? "Koleksi tutorial, tips & trik, dan panduan untuk membantu perjalanan coding kamu."}
        </p>
    </header>

    <div class="mx-auto mb-10 max-w-md">
        <SearchBar items={searchItems} placeholder="Cari artikel..." client:idle />
    </div>

    <CategoryFilter categories={filterCategories} active={cat ?? undefined} basePath="/posts" />
    {
        sortedPosts.length > 0 ? (
            <section class="mx-auto max-w-7xl pb-18">
                <div class="grid grid-cols-1 gap-y-14 gap-x-8 md:grid-cols-2 lg:grid-cols-3">
                    {pagePosts.map((post, i) => (
                        <a data-animate href={`/posts/${post.id}`} class="group block overflow-hidden transition-all duration-300" style={`--d:${(i % 6) * 60}ms`}>
                            <div class="relative mb-6 aspect-391/249 w-full overflow-hidden rounded-xl bg-[#d9d9d9]">
                                {post.data.featured_image ? (
                                    <Image
                                        src={post.data.featured_image}
                                        alt={post.data.title}
                                        width={800}
                                        height={512}
                                        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                                        densities={[1, 2]}
                                        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                                        loading="lazy"
                                    />
                                ) : (
                                    <div class="flex h-full w-full items-center justify-center text-[#aaa]">
                                        <ImageIcon width="64" height="64" stroke-width="1.8" />
                                    </div>
                                )}
                            </div>
                            <div>
                                <h3 class="mb-2 text-xl font-bold leading-snug text-coc-text transition-colors group-hover:text-coc-accent">{post.data.title}</h3>
                                {post.data.description && <p class="mb-6 line-clamp-2 text-sm text-coc-muted">{post.data.description}</p>}
                                <div class="flex items-center gap-2">
                                    <span class="text-xs text-coc-muted-soft">
                                        {post.data.publishDate
                                            ? new Intl.DateTimeFormat("id-ID", {
                                                  day: "numeric",
                                                  month: "long",
                                                  year: "numeric",
                                              }).format(post.data.publishDate)
                                            : ""}
                                    </span>
                                </div>
                            </div>
                        </a>
                    ))}
                </div>

                <Pagination page={page} totalPages={totalPages} basePath="/posts" query={cat ? { cat } : {}} />
            </section>
        ) : (
            <div class="flex flex-col items-center justify-center py-20 text-center">
                <p class="text-lg text-coc-muted">Belum ada artikel untuk kategori ini.</p>
                <a href="/posts" class="mt-4 inline-flex items-center rounded-full bg-coc-dark px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-black">
                    Lihat Semua Artikel
                </a>
            </div>
        )
    }
    <BackToTop client:idle />
    <ScrollAnimations />
</BaseLayout>
