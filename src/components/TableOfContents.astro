---
import type { Heading } from "../lib/markdown";

interface Props {
    headings: Heading[];
    title?: string;
}

const { headings, title = "Daftar Isi" } = Astro.props;
---

<div class="space-y-4" data-toc>
    <h2 class="text-sm font-bold uppercase tracking-wider text-coc-text">{title}</h2>
    <nav aria-label="Daftar isi" class="space-y-1">
        {
            headings.map((h) => (
                <a href={`#${h.slug}`} class="toc-link flex items-start gap-3 rounded-lg px-2 py-2 text-sm leading-6 text-coc-muted transition-colors hover:bg-coc-line-light hover:text-coc-text">
                    <span class="toc-dot mt-2 size-1.5 shrink-0 rounded-full border border-coc-line transition-colors" />
                    <span class="toc-text">{h.text}</span>
                </a>
            ))
        }
    </nav>
</div>

<style is:global>
    .toc-link {
        position: relative;
    }
    .toc-link.is-active {
        color: var(--color-text);
        font-weight: 700;
    }
    .toc-link.is-active .toc-dot {
        background: var(--color-accent);
        border-color: transparent;
    }
    /* Per-section scroll progress: an accent bar that fills as the reader
     scrolls through each heading's section. */
    /* .toc-link::after {
        content: "";
        position: absolute;
        left: 0.5rem;
        right: 0.5rem;
        bottom: 0.1rem;
        height: 2px;
        border-radius: 2px;
        background: var(--color-accent);
        width: calc(var(--progress, 0) * 100%);
        opacity: 0.85;
        transform-origin: left;
        transition: width 80ms linear;
    } */
</style>

<script>
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".toc-link"));
    const targets = links
        .map((link) => {
            const id = link.getAttribute("href")?.slice(1) ?? "";
            const heading = document.getElementById(id);
            return heading ? { id, link, heading } : null;
        })
        .filter(
            (
                t,
            ): t is {
                id: string;
                link: HTMLAnchorElement;
                heading: HTMLElement;
            } => t !== null,
        );

    if (targets.length) {
        const setActive = (id: string) => {
            for (const { link, id: linkId } of targets) {
                link.classList.toggle("is-active", linkId === id);
            }
        };

        let raf = 0;
        let activeId = targets[0].id;

        const update = () => {
            raf = 0;
            const doc = document.documentElement;
            const scrollY = window.scrollY;
            const viewportBottom = scrollY + window.innerHeight;
            const nearBottom = viewportBottom >= doc.scrollHeight - 8;
            const marker = scrollY + window.innerHeight * 0.35;

            let current = targets[0].id;
            for (const t of targets) {
                const rect = t.heading.getBoundingClientRect();
                const top = rect.top + scrollY;
                const height = Math.max(1, rect.height);
                const progress = Math.min(1, Math.max(0, (marker - top) / height));
                t.link.style.setProperty("--progress", progress.toFixed(3));
                if (top <= marker) current = t.id;
            }

            if (nearBottom) {
                activeId = targets[targets.length - 1].id;
            } else {
                activeId = current;
            }
            setActive(activeId);
        };

        const onScroll = () => {
            if (raf === 0) raf = window.requestAnimationFrame(update);
        };

        update();
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll, { passive: true });
    }
</script>
