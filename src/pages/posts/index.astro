---
import { getCollection, getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import { ImageIcon } from "@lucide/astro";
import { SITE_TITLE } from "../../consts";
import SearchBar from "../../components/ui/SearchBar.tsx";
import BackToTop from "../../components/ui/BackToTop.tsx";
import ScrollAnimations from "../../components/ScrollAnimations.astro";

type Tone = "yellow" | "green" | "pink";

const posts = await getCollection("posts");
const categories = await getCollection("categories");
const cat = Astro.url.searchParams.get("cat");
const selectedCategory = categories.find((c) => c.id === cat);

const filteredPosts = cat ? posts.filter((p) => p.data.category === cat) : posts;

const toneClass: Record<Tone, string> = {
  yellow: "bg-coc-tag-yellow",
  green: "bg-coc-tag-green",
  pink: "bg-coc-tag-pink",
};

const categoryLabel = new Map<string, string>();
for (const cat of categories) {
  categoryLabel.set(cat.id, cat.data.label);
}

const searchItems = posts.map((p) => ({
  title: p.data.title,
  description: p.data.description ?? "",
  url: `/posts/${p.id}`,
  category: categoryLabel.get(p.data.category) ?? "",
}));
---

<BaseLayout
  title={`${selectedCategory ? selectedCategory.data.label + " — " : "Semua Artikel"} | ${SITE_TITLE}`}
  description={selectedCategory ? `Kumpulan artikel kategori ${selectedCategory.data.label}` : "Daftar semua artikel cup of code."}
>
  <header class="mx-auto mb-8 flex max-w-3xl flex-col items-center text-center">
    <p class="mb-6 inline-block rounded-full bg-coc-tag-yellow px-3 py-1 text-xs font-semibold text-[#212121]">
      {cat ? "Kategori" : "Jelajahi"}
    </p>
    <h1 class="mb-3 font-coc-display text-4xl leading-tight tracking-tight text-coc-text md:text-5xl">
      {selectedCategory ? selectedCategory.data.label : "Semua Artikel"}
    </h1>
    <p class="mx-auto max-w-2xl text-base leading-relaxed text-coc-muted md:text-lg">
      {selectedCategory
        ? `Kumpulan artikel dalam kategori ${selectedCategory.data.label}.`
        : "Koleksi tutorial, tips & trik, dan panduan untuk membantu perjalanan coding kamu."}
    </p>
  </header>

  <div class="mx-auto mb-10 max-w-md">
    <SearchBar items={searchItems} placeholder="Cari artikel..." client:idle />
  </div>

  {
    filteredPosts.length > 0 ? (
      <section class="mx-auto max-w-7xl pb-18">
        <div class="grid grid-cols-1 gap-y-14 gap-x-8 md:grid-cols-2 lg:grid-cols-3">
          {
            filteredPosts.map((post) => (
              <a data-animate
                href={`/posts/${post.id}`}
                class="group block overflow-hidden transition-all duration-300"
              >
                <div class="relative mb-6 aspect-391/249 w-full overflow-hidden rounded-xl bg-[#d9d9d9]">
                  {post.data.featured_image ? (
                    <Image
                      src={post.data.featured_image}
                      alt={post.data.title}
                      width={800}
                      height={509}
                      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw" densities={[1, 2]}
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center text-[#aaa]">
                      <ImageIcon width="64" height="64" stroke-width="1.8" />
                    </div>
                  )}
                </div>
                <div>
                  <h3 class="mb-2 text-xl font-bold leading-snug text-coc-text transition-colors group-hover:text-coc-accent">
                    {post.data.title}
                  </h3>
                  {post.data.description && (
                    <p class="mb-6 line-clamp-2 text-sm text-coc-muted">
                      {post.data.description}
                    </p>
                  )}
                  <div class="flex items-center gap-2">
                    <span class="text-xs text-coc-muted-soft">
                      {post.data.publishDate
                        ? new Intl.DateTimeFormat("id-ID", {
                            day: "numeric",
                            month: "long",
                            year: "numeric",
                          }).format(post.data.publishDate)
                        : ""}
                    </span>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </section>
    ) : (
      <div class="flex flex-col items-center justify-center py-20 text-center">
        <p class="text-lg text-coc-muted">Belum ada artikel untuk kategori ini.</p>
        <a
          href="/posts"
          class="mt-4 inline-flex items-center rounded-full bg-coc-dark px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-black"
        >
          Lihat Semua Artikel
        </a>
      </div>
    )
  }
  <BackToTop client:idle />
  <ScrollAnimations />
</BaseLayout>
