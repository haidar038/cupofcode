---
import { Inbox } from "@lucide/astro";

interface Props {
  title?: string;
  message?: string;
  actionLabel?: string;
  actionHref?: string;
}

const { title = "Belum Ada Konten", message = "Konten untuk bagian ini belum tersedia. Silakan periksa kembali nanti.", actionLabel, actionHref } = Astro.props;
---

<div class="flex flex-col items-center justify-center rounded-3xl border border-coc-line bg-coc-surface p-12 text-center">
  <div class="mb-4 flex size-16 items-center justify-center rounded-full bg-gray-100 text-coc-muted-soft">
    <Inbox width="32" height="32" />
  </div>
  <h2 class="mb-2 text-xl font-bold text-coc-text">{title}</h2>
  <p class="mb-6 max-w-md text-sm leading-relaxed text-coc-muted">{message}</p>
  {
    actionLabel && actionHref && (
      <a
        href={actionHref}
        class="inline-flex items-center rounded-full bg-coc-dark px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-black"
      >
        {actionLabel}
      </a>
    )
  }
</div>
