---
export const prerender = true;
import BaseLayout from "../layouts/BaseLayout.astro";
import FeaturedImage from "../assets/blog-placeholder-1.jpg";
import AvatarSVG from "../assets/avatar.svg";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { ImageIcon } from "@lucide/astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import SearchBar from "../components/ui/SearchBar.tsx";
import BackToTop from "../components/ui/BackToTop.tsx";
import ScrollAnimations from "../components/ScrollAnimations.astro";

type Tone = "yellow" | "green" | "pink";

const categories = await getCollection("categories");
const allPosts = await getCollection("posts");
const featuredPosts = allPosts.filter((p) => p.data.featured);
const featuredArticle = featuredPosts.length > 0 ? featuredPosts[0] : allPosts[0];
const gridArticles = allPosts.filter((p) => p.id !== featuredArticle?.id).slice(0, 4);

// Filter sidebar: article categories (Aset Digital is handled as a special
// "content type" filter that renders the digital assets grid in place).
const articleCategories = categories.filter((c) => c.id !== "aset-digital");

const countByCategory = new Map<string, number>();
for (const cat of articleCategories) {
    countByCategory.set(cat.id, allPosts.filter((p) => p.data.category === cat.id).length);
}

const toneClass: Record<Tone, string> = {
    yellow: "bg-coc-tag-yellow",
    green: "bg-coc-tag-green",
    pink: "bg-coc-tag-pink",
};

const toneByCategory = new Map<string, Tone>();
for (const cat of categories) {
    toneByCategory.set(cat.id, cat.data.tone as Tone);
}

const categoryLabel = new Map<string, string>();
for (const cat of categories) {
    categoryLabel.set(cat.id, cat.data.label);
}

const searchItems = allPosts.map((p) => ({
    title: p.data.title,
    description: p.data.description ?? "",
    url: `/posts/${p.id}`,
    category: categoryLabel.get(p.data.category) ?? "",
}));
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
    <section class="grid items-start gap-8 md:grid-cols-[minmax(0,1fr)_minmax(150px,240px)] lg:gap-12" aria-labelledby="hero-title">
        <div class="max-w-173.75" data-animate="fade-up">
            <p class="mb-3">
                <span class="rounded bg-coc-tag-yellow px-1 py-0.5 text-sm font-medium text-[#7a5a00] md:hidden">Explore Everything. Your Journey Starts Here.</span>
                <span class="hidden rounded-full bg-coc-tag-yellow px-3 py-1 text-sm font-semibold uppercase tracking-wide text-coc-text md:inline-block"
                    >Explore Everything. Your Journey Starts Here.</span
                >
            </p>
            <h1 id="hero-title" class="font-coc-display text-5xl leading-1.2 text-coc-text sm:text-5xl lg:text-6xl lg:leading-18">
                Belajar Coding, Web Development, UI/UX, dan AI Bareng<span class="text-coc-accent">.</span>
            </h1>
            <p class="mt-4 max-w-170 text-base text-coc-muted lg:text-lg leading-7">
                Cup of Code adalah publication dan resource gratis tentang software development, UI/UX design, dan AI-assisted development. Kami menyediakan tutorial, artikel, snippets, dan aset
                digital untuk membantu developer belajar serta membangun produk dengan pemahaman yang lebih baik.
            </p>
        </div>
        <div class="pointer-events-none justify-self-end self-start hidden md:block" aria-hidden="true" data-animate="scale" style="--d:120ms">
            <Image src={AvatarSVG} alt="" class="h-auto w-30 max-w-none object-contain sm:w-38 md:w-48 lg:w-60" loading="eager" />
        </div>
    </section>

    <!-- <section class="mt-14 max-w-3xl lg:mt-18" aria-labelledby="about-cup-of-code">
        <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-coc-accent">Explore Everything. Your Journey Starts Here.</p>
        <h2 id="about-cup-of-code" class="font-coc-display text-3xl text-coc-text md:text-4xl">Apa itu Cup of Code?</h2>
        <p class="mt-4 text-base leading-7 text-coc-muted md:text-lg">
            Cup of Code adalah publication dan resource gratis tentang software development, UI/UX design, dan AI-assisted development. Kami menyediakan tutorial, artikel, snippets, dan aset digital
            untuk membantu developer belajar serta membangun produk dengan pemahaman yang lebih baik.
        </p>
    </section> -->

    <section id="artikel" class="mt-14 grid gap-10 lg:mt-18 lg:grid-cols-[306px_minmax(0,1fr)] lg:gap-14" aria-label="Artikel Cup of Code">
        <aside class="filter-sidebar grid gap-8 sm:grid-cols-[minmax(260px,360px)_minmax(0,1fr)] lg:sticky lg:top-6 lg:block lg:space-y-8">
            <div class="space-y-3">
                <h2 class="text-base font-semibold leading-6 text-coc-text mb-3">Pencarian</h2>
                <SearchBar items={searchItems} placeholder="Cari Artikel..." client:idle />
            </div>
            <div class="space-y-3">
                <h2 class="text-base font-semibold leading-6 text-coc-text mb-3">Kategori</h2>
                <ul class="space-y-1 text-base leading-6" role="list" aria-label="Filter kategori artikel">
                    <li>
                        <button type="button" data-filter="all" data-name="Semua Artikel" class="filter-btn is-active" aria-current="true">
                            <span class="filter-dot size-2 rounded-full bg-coc-accent"></span>
                            <span>Semua</span>
                            <span class="filter-count">{allPosts.length}</span>
                        </button>
                    </li>
                    {
                        articleCategories.map((category) => (
                            <li>
                                <button type="button" data-filter={category.id} data-name={category.data.label} class="filter-btn">
                                    <span class="filter-dot size-2 rounded-full bg-[#ddd]" />
                                    <span>{category.data.label}</span>
                                    <span class="filter-count">{countByCategory.get(category.id) ?? 0}</span>
                                </button>
                            </li>
                        ))
                    }
                    <!-- <li>
                        <button type="button" data-filter="assets" data-name="Aset Digital" class="filter-btn">
                            <span class="filter-dot size-2 rounded-full bg-[#ddd]"></span>
                            <span>Aset Digital</span>
                            <span class="filter-count">{assetCount}</span>
                        </button>
                    </li> -->
                </ul>
                <p class="pt-2 text-xs leading-5 text-coc-muted-soft">Klik kategori untuk menyaring artikel & aset digital tanpa pindah halaman.</p>
            </div>
        </aside>

        <div class="flex min-w-0 flex-col gap-12 lg:gap-14">
            {
                featuredArticle &&
                    (() => {
                        const fCat = categories.find((c) => c.id === featuredArticle.data.category);
                        const fTone: Tone = (fCat?.data.tone as Tone) || "yellow";
                        return (
                            <article data-home-featured data-animate class="grid gap-6 md:grid-cols-[minmax(0,1.22fr)_minmax(260px,0.9fr)] md:items-center lg:gap-8">
                                <a class="block overflow-hidden rounded-3xl bg-[#d9d9d9] transition hover:-translate-y-0.5" href={`/posts/${featuredArticle.id}`}>
                                    {featuredArticle.data.featured_image ? (
                                        <Image
                                            src={featuredArticle.data.featured_image}
                                            alt={featuredArticle.data.title}
                                            width={1200}
                                            height={758}
                                            sizes="(max-width: 768px) 100vw, 60vw"
                                            densities={[1, 2]}
                                            class="aspect-462/292 h-full w-full object-cover transition duration-200 hover:scale-[1.02]"
                                            loading="eager"
                                            fetchpriority="high"
                                        />
                                    ) : (
                                        <Image
                                            src={FeaturedImage}
                                            alt={featuredArticle.data.title}
                                            sizes="(max-width: 768px) 100vw, 60vw"
                                            densities={[1, 2]}
                                            class="aspect-462/292 h-full w-full object-cover transition duration-200 hover:scale-[1.02]"
                                            loading="eager"
                                            fetchpriority="high"
                                        />
                                    )}
                                </a>
                                <div class="flex flex-col items-start gap-4 md:gap-5">
                                    <span class:list={["rounded-full px-3 py-1 text-xs leading-4 text-[#212121]", toneClass[fTone]]}>{fCat?.data.label || "Artikel"}</span>
                                    <h2 class="font-coc-body text-2xl font-bold leading-8 text-coc-text lg:text-[32px] lg:leading-10">
                                        <a href={`/posts/${featuredArticle.id}`} class="hover:text-coc-accent">
                                            {featuredArticle.data.title}
                                        </a>
                                    </h2>
                                    <p class="line-clamp-4 text-base leading-6 text-coc-muted">{featuredArticle.data.description}</p>
                                </div>
                            </article>
                        );
                    })()
            }

            <div class="hidden items-center justify-between gap-4 rounded-2xl border border-coc-line bg-coc-surface px-5 py-4" data-filter-status role="status">
                <p class="text-sm leading-6 text-coc-muted">
                    Menampilkan <b class="text-coc-text" data-filter-count>0</b> hasil untuk <b class="text-coc-text" data-filter-name></b>
                </p>
                <div class="flex shrink-0 items-center gap-4">
                    <a href="/assets" class="hidden text-sm font-semibold text-coc-accent transition-colors hover:text-coc-text" data-filter-assets-link> Lihat halaman Aset Digital &rarr; </a>
                    <button type="button" data-filter-reset class="text-sm font-semibold text-coc-muted transition-colors hover:text-coc-text"> Reset filter </button>
                </div>
            </div>

            <div data-home-grid>
                <div class="grid gap-10 sm:grid-cols-2 lg:gap-x-14 lg:gap-y-12">
                    {
                        gridArticles.map((article, i) => {
                            const gCat = categories.find((c) => c.id === article.data.category);
                            const gTone: Tone = (gCat?.data.tone as Tone) || "yellow";
                            return (
                                <article data-animate class="flex flex-col items-start gap-5 transition hover:-translate-y-0.5" style={`--d:${(i % 4) * 70}ms`}>
                                    <a
                                        class="flex aspect-391/249 w-full items-center justify-center overflow-hidden rounded-3xl bg-[#d9d9d9] text-[#aaa]"
                                        href={`/posts/${article.id}`}
                                        aria-label={`Baca artikel ${article.data.title}`}
                                        title={article.data.title}
                                    >
                                        {article.data.featured_image ? (
                                            <Image
                                                src={article.data.featured_image}
                                                alt={article.data.title}
                                                width={800}
                                                height={512}
                                                sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw"
                                                densities={[1, 2]}
                                                class="h-full w-full object-cover transition duration-200 hover:scale-[1.02]"
                                                loading="lazy"
                                            />
                                        ) : (
                                            <ImageIcon width="96" height="96" stroke-width="1.8" />
                                        )}
                                    </a>
                                    <div class="flex flex-col items-start gap-3">
                                        <span class:list={["rounded-full px-3 py-1 text-xs leading-4 text-[#212121]", toneClass[gTone]]}>{gCat?.data.label || "Artikel"}</span>
                                        <h3 class="text-xl font-bold leading-7 text-coc-text sm:text-2xl sm:leading-8">
                                            <a href={`/posts/${article.id}`} class="hover:text-coc-accent">
                                                {article.data.title}
                                            </a>
                                        </h3>
                                        {article.data.description && <p class="line-clamp-2 text-base leading-6 text-coc-muted">{article.data.description}</p>}
                                    </div>
                                </article>
                            );
                        })
                    }
                </div>
                <div class="mt-10 flex justify-center">
                    <a
                        href="/posts"
                        class="flex px-6 items-center justify-center gap-2 rounded-full bg-coc-dark py-4 text-sm font-semibold text-white transition-colors hover:bg-coc-accent disabled:cursor-not-allowed disabled:opacity-60"
                    >
                        Lebih Banyak
                    </a>
                </div>
            </div>
        </div>
    </section>
    <BackToTop client:idle />
    <ScrollAnimations />
</BaseLayout>

<style>
    .filter-btn {
        display: flex;
        width: 100%;
        align-items: center;
        gap: 0.75rem;
        padding: 0.45rem 0;
        background: transparent;
        color: var(--color-muted);
        font-size: 1rem;
        line-height: 1.5;
        text-align: left;
        cursor: pointer;
        transition: color 200ms ease-in-out;
    }
    .filter-btn:hover {
        color: var(--color-text);
    }
    .filter-btn.is-active {
        color: var(--color-text);
        font-weight: 700;
    }
    .filter-btn.is-active .filter-dot {
        background: var(--color-accent);
    }
    .filter-count {
        margin-left: auto;
        flex-shrink: 0;
        min-width: 1.6rem;
        padding: 0.05rem 0.5rem;
        border-radius: 9999px;
        background: var(--color-line-light);
        color: var(--color-muted-soft);
        font-size: 0.72rem;
        font-weight: 700;
        line-height: 1.4;
        text-align: center;
    }
    .filter-btn.is-active .filter-count {
        background: var(--color-coc-tag-yellow);
        color: var(--color-text);
    }

    @media (min-width: 1024px) {
        .filter-sidebar {
            position: sticky;
            top: 1.5rem;
            align-self: start;
        }
    }
</style>

<script>
    import { initHomeFilter } from "../components/home-filter";
    const run = () => initHomeFilter();
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", run);
    } else {
        run();
    }
    document.addEventListener("astro:page-load", run);
</script>
