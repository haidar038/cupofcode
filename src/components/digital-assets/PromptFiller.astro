---
interface Props {
  variables?: string[];
}

const { variables = [] } = Astro.props;
---

<div class="rounded-3xl border border-coc-line bg-coc-surface p-6 md:p-8">
  <div class="mb-6 border-b border-coc-line pb-4">
    <h3 class="flex items-center gap-2 text-lg font-bold text-coc-text">
      Sesuaikan Prompt
    </h3>
    <p class="mt-1 text-xs text-coc-muted-soft">
      Isi variabel di bawah ini, teks hasil akan berubah otomatis.
    </p>
  </div>

  <form class="space-y-5">
    {variables.map((v) => (
      <div>
        <label class="mb-2 block text-sm font-bold text-coc-text">{v}</label>
        <input
          type="text"
          placeholder={`Masukkan ${v.toLowerCase()}...`}
          class="w-full rounded-xl border border-coc-line bg-gray-50 px-4 py-3 text-sm text-coc-text transition-all focus:border-coc-accent focus:outline-none focus:ring-1 focus:ring-coc-accent"
        />
      </div>
    ))}
    {variables.length === 0 && (
      <div>
        <label class="mb-2 block text-sm font-bold text-coc-text">Input</label>
        <textarea
          rows="4"
          placeholder="Masukkan teks di sini..."
          class="w-full rounded-xl border border-coc-line bg-gray-50 px-4 py-3 font-mono text-sm text-coc-text transition-all focus:border-coc-accent focus:outline-none focus:ring-1 focus:ring-coc-accent"
        ></textarea>
      </div>
    )}
  </form>
</div>
