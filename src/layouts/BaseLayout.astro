---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import { buildWebsiteGraph } from "../lib/seo";

export interface Props {
    title: string;
    description: string;
    image?: string;
    type?: string;
    robots?: string;
}

const { title, description, image, type, robots } = Astro.props;
const websiteGraph = buildWebsiteGraph();
---

<!doctype html>
<html lang="id" class="">
    <head>
        <ClientRouter />
        <BaseHead {title} {description} {image} {type} {robots} />
        <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteGraph)} />
    </head>
    <body class="bg-coc-bg text-coc-text">
        <Header />
        <main class="mx-auto w-full max-w-360 overflow-x-clip px-4 py-10 sm:px-6 sm:py-12 lg:px-20 lg:py-18 xl:px-30">
            <slot />
        </main>
        <Footer />
    </body>
</html>
