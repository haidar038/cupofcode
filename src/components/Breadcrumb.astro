---
import { SITE_URL } from "../consts";

interface Props {
    items: { label: string; href?: string }[];
}

const { items } = Astro.props;

const currentUrl = new URL(Astro.url.pathname, SITE_URL).href;

const crumbs = [
    { name: "Beranda", url: new URL("/", SITE_URL).href },
    ...items.map((item, i) => {
        const isLast = i === items.length - 1;
        const url = item.href ? new URL(item.href, SITE_URL).href : isLast ? currentUrl : undefined;
        return { name: item.label, url };
    }),
];

const breadcrumbLd = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        ...(c.url ? { item: c.url } : {}),
    })),
};
---

<nav class="mb-8 flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1 text-sm font-medium text-coc-muted" aria-label="Breadcrumb">
    <ol class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1">
        <li class="shrink-0">
            <a href="/" class="whitespace-nowrap transition-colors hover:text-coc-text">Beranda</a>
        </li>
        {
            items.map((item, i) => {
                const isLast = i === items.length - 1;
                return (
                    <li class:list={["flex min-w-0 items-center gap-2", isLast && "flex-1 basis-32"]}>
                        <span class="shrink-0 text-xs text-coc-line" aria-hidden="true">
                            /
                        </span>
                        {item.href && !isLast ? (
                            <a href={item.href} class="shrink-0 whitespace-nowrap transition-colors hover:text-coc-text">
                                {item.label}
                            </a>
                        ) : (
                            <span class="truncate text-coc-text" title={item.label} aria-current={isLast ? "page" : undefined}>
                                {item.label}
                            </span>
                        )}
                    </li>
                );
            })
        }
    </ol>
</nav>

<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
