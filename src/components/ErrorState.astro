---
import { TriangleAlert, RefreshCw } from "@lucide/astro";

interface Props {
    title?: string;
    message?: string;
    showRetry?: boolean;
    retryHref?: string;
}

const { title = "Terjadi Kesalahan", message = "Maaf, terjadi kesalahan saat memuat halaman. Silakan coba lagi.", showRetry = true, retryHref = "#" } = Astro.props;
---

<div class="flex flex-col items-center justify-center rounded-3xl border border-coc-line bg-coc-surface p-12 text-center">
    <div class="mb-4 flex size-16 items-center justify-center rounded-full bg-red-50 text-red-500">
        <TriangleAlert width="32" height="32" />
    </div>
    <h2 class="mb-2 text-xl font-bold text-coc-text">{title}</h2>
    <p class="mb-6 max-w-md text-sm leading-relaxed text-coc-muted">{message}</p>
    {
        showRetry && (
            <a href={retryHref} class="inline-flex items-center gap-2 rounded-full bg-coc-dark px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-black">
                <RefreshCw width="18" height="18" />
                Coba Lagi
            </a>
        )
    }
</div>
