---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import { buildWebsiteSchemas } from "../lib/seo";

export interface Props {
    title: string;
    description: string;
    image?: string;
    type?: string;
    robots?: string;
}

const { title, description, image, type, robots } = Astro.props;
const websiteSchemas = buildWebsiteSchemas();
---

<!doctype html>
<html lang="id" class="">
    <head>
        <ClientRouter />
        <BaseHead {title} {description} {image} {type} {robots} />
        <slot name="head" />
        {websiteSchemas.map((schema) => <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />)}
    </head>
    <body class="bg-coc-bg text-coc-text">
        <a
            href="#main-content"
            class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-xl focus:bg-coc-dark focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white"
        >
            Lewati ke konten utama
        </a>
        <Header />
        <main id="main-content" tabindex="-1" transition:animate="fade" class="mx-auto w-full max-w-360 overflow-x-clip px-4 py-10 sm:px-6 sm:py-12 lg:px-20 lg:py-18 xl:px-30 focus:outline-hidden">
            <slot />
        </main>
        <Footer />
    </body>
</html>
