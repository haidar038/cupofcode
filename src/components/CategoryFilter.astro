---
/**
 * Pill-style category filter for article listing pages.
 *
 * Renders a centered row of pill links (anchors, so each selection is a real,
 * shareable URL that works without JS) and marks the active one. Styling
 * matches the site's light, rounded aesthetic (see Pagination / SearchBar).
 *
 * Props:
 * - categories: category entries to render as pills (id + label)
 * - active: category id that is currently selected ("undefined" = none = all)
 * - basePath: href prefix; the "Semua" pill becomes `${basePath}`
 * - linkFor: optional custom href resolver for a category id. When omitted,
 *   pills use query-param style `${basePath}?cat=<id>` (filter within the
 *   same listing). Pass a resolver to point pills at dedicated category
 *   routes instead, e.g. `(id) => `/posts/${id}``.
 */
import type { CollectionEntry } from "astro:content";

interface Props {
    categories: CollectionEntry<"categories">[];
    active?: string;
    basePath?: string;
    linkFor?: (id: string) => string;
}

const { categories, active, basePath = "/posts", linkFor } = Astro.props;

const allHref = basePath;
const categoryHref = linkFor ?? ((id: string) => `${basePath}?cat=${id}`);
---

<nav class="filter-nav" aria-label="Filter kategori artikel">
    <ul class="filter-list" role="list">
        <li>
            <a href={allHref} aria-current={active ? undefined : "page"} class:list={["filter-pill", { "is-active": !active }]}>
                Semua
            </a>
        </li>
        {
            categories.map((category) => (
                <li>
                    <a
                        href={categoryHref(category.id)}
                        aria-current={active === category.id ? "page" : undefined}
                        class:list={["filter-pill", { "is-active": active === category.id }]}
                    >
                        {category.data.label}
                    </a>
                </li>
            ))
        }
    </ul>
</nav>

<style>
    .filter-nav {
        display: flex;
        justify-content: center;
        margin-bottom: 2rem;
    }
    .filter-list {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }
    .filter-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.55rem 1.15rem;
        border: 1px solid var(--color-line);
        border-radius: 9999px;
        background: var(--color-surface);
        color: var(--color-muted);
        font-size: 0.875rem;
        font-weight: 600;
        line-height: 1.25;
        text-align: center;
    }
    .filter-pill:hover {
        border-color: var(--color-accent);
        color: var(--color-text);
    }
    .filter-pill.is-active {
        border-color: var(--color-accent);
        background: var(--color-coc-tag-yellow);
        color: #212121;
        font-weight: 700;
    }
    .filter-pill:focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 2px;
    }
</style>
